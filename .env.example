VITE_SUPABASE_URL=https://gzznbchlgkqcmcoswsef.supabase.co
VITE_SUPABASE_ANON_KEY=PASTE_YOUR_ANON_KEY_HERE
# Lấy anon key tại: https://supabase.com/dashboard/project/gzznbchlgkqcmcoswsef/settings/api -> Project API keys -> anon public
# KHÔNG dùng service_role ở frontend. service_role chỉ dùng server/Edge Functions.

# Demo mode: "demo" = dùng localStorage, không cần Supabase. Để chạy web chính thức, để trống:
VITE_DEMO_MODE=

# Bucket chính thức (PRIVATE): luutruhoso
# Dashboard: https://supabase.com/dashboard/project/gzznbchlgkqcmcoswsef/storage/files/buckets/luutruhoso
# SQL: supabase/schema.sql + supabase/seed.sql + supabase/storage-policies.sql

# Trợ lý AI (Edge Function supabase/functions/ai-chat, key Groq giữ server-side):
# 1. Lấy key tại https://console.groq.com/keys
# 2. Supabase Dashboard -> Edge Functions -> New Function (tên ai-chat) -> dán supabase/functions/ai-chat/index.ts + upload kb.json cùng thư mục
# 3. Edge Functions -> Secrets -> thêm GROQ_API_KEY (optional: AI_MODEL, mặc định llama-3.3-70b-versatile)
# Kho kb.json không bị ảnh hưởng khi đổi nhà cung cấp AI. Chưa cấu hình key: chat chạy offline.
# Function cam-nang (supabase/functions/cam-nang/index.ts): KHÔNG cần secret, dán code -> Deploy là chạy.
